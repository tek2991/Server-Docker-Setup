APP_NAME=SiteB
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://site-b.internal.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# Shared MariaDB Stack
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=site_b
DB_USERNAME=site_b
DB_PASSWORD=change_me_site_b

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Shared Redis Stack
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=1
REDIS_CACHE_DB=2

FILESYSTEM_DISK=public
